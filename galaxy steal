        Vector3.new(-475.00, -7.3,  30.07),
        Vector3.new(-476.65, -6.7,  26.77),
        Vector3.new(-483.01, -5.4,  26.91),
    },
}

local function detectSide()
    local plots = workspace:FindFirstChild("Plots")
    if plots then
        for _, plot in pairs(plots:GetChildren()) do
            for _, d in pairs(plot:GetDescendants()) do
                if d:IsA("TextLabel") or d:IsA("TextButton") then
                    local txt = d.Text
                    if txt and (txt:find(localPlayer.Name, 1, true)
                             or txt:find(localPlayer.DisplayName, 1, true)) then
                        local root = plot:FindFirstChild("MainRoot")
                                  or plot:FindFirstChildWhichIsA("BasePart", true)
                        if root then
                            return root.Position.Z > 60 and "Left" or "Right"
                        end
                    end
                end
            end
        end
    end
    local hrp = localPlayer.Character
        and (localPlayer.Character:FindFirstChild("HumanoidRootPart")
          or localPlayer.Character:FindFirstChild("Torso"))
    if hrp then
        return hrp.Position.Z > 60 and "Left" or "Right"
    end
    return nil
end

function oppositeSide()
    local s = detectSide()
    return s and (s == "Left" and "Right" or "Left") or nil
end

local tpInProgress = false
local lastTP = 0

doRagdollTP = function()
    if tpInProgress then return false end
    local side = oppositeSide()
    if not side then
        notify("TP failed: could not detect side", true)
        return false
    end
    local pts = WAYPOINTS[side]
    if not pts or #pts < 2 then return false end

    local start  = pts[1]
    local finish = pts[#pts]
    local mid    = pts[math.floor(#pts / 2)]

    tpInProgress = true
    task.spawn(function()
        local char = localPlayer.Character
        if char then
            char:PivotTo(CFrame.new(start))
            task.wait(0.15)
            char:PivotTo(CFrame.new(mid))
            task.wait(0.15)
            char:PivotTo(CFrame.new(finish))
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
        end
        task.wait(0.1)
        tpInProgress = false
    end)
    return true
end

