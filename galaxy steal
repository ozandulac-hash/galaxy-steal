-- Notification toast
-- ──────────────────────────────────────────────────────────────
local toastLabel
local toastId = 0

local function notify(text, isError)
    if not toastLabel then return end
    toastId += 1
    local id = toastId
    toastLabel.Text = text
    toastLabel.BackgroundColor3 = isError
        and Color3.fromRGB(90, 12, 35)
        or  Color3.fromRGB(12, 70, 35)
    toastLabel.Visible = true
    task.delay(2, function()
        if toastId == id then toastLabel.Visible = false end
    end)
end

-- ──────────────────────────────────────────────────────────────
-- Ragdoll timer UI
-- ──────────────────────────────────────────────────────────────
local ragTimerLabel
local ragTimerActive = false

local function ragColor(t)
    if t > 2 then return COL.purple1 end
    if t > 1 then return COL.purple2 end
    return COL.purple3
end

local doRagdollTP -- forward declaration

local function startRagdollTimer()
    if ragTimerActive then return end
    ragTimerActive = true

    task.spawn(function()
        local t = 2.6
        local tpFired = false

        while t >= 0 do
            if not ragTimerLabel then
                ragTimerActive = false
                return
            end
            ragTimerLabel.Text = string.format("%.1f", t)
            ragTimerLabel.TextColor3 = ragColor(t)

            if not tpFired and t <= 0.5 and cfg.autoRagdollTP and doRagdollTP then
                tpFired = true
                doRagdollTP()
            end

            task.wait(0.1)
            t = math.round((t - 0.1) * 10) / 10
        end

        if ragTimerLabel then
            ragTimerLabel.Text = "STEAL!"
            ragTimerLabel.TextColor3 = Color3.fromRGB(100, 255, 200)
        end

        repeat
            task.wait(0.1)
        until (function()
            local hum = localPlayer.Character
                and localPlayer.Character:FindFirstChildOfClass("Humanoid")
            if not hum then return true end
            local st = hum:GetState()
            return st ~= Enum.HumanoidStateType.Physics
               and st ~= Enum.HumanoidStateType.Ragdoll
               and st ~= Enum.HumanoidStateType.FallingDown
        end)()

        if ragTimerLabel then ragTimerLabel.Text = "" end
        ragTimerActive = false
    end)
end

local function watchRagdoll(char)
    RunService.Heartbeat:Connect(function()
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.Physics
        or st == Enum.HumanoidStateType.Ragdoll
        or st == Enum.HumanoidStateType.FallingDown then
            startRagdollTimer()
        end
    end)
end

