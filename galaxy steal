-- Ragdoll-steal pause logic
-- ──────────────────────────────────────────────────────────────
ragToggle.MouseButton1Click:Connect(function()
    cfg.ragdollSteal = not cfg.ragdollSteal
    refreshRagToggle()
    saveConfig()
    if not cfg.ragdollSteal and inRagPause then
        if wasEnabledBeforeRag then
            setAuto(true)
        end
        inRagPause = false
        wasEnabledBeforeRag = false
    end
end)

local function enterRagPause()
    if inRagPause then return end
    inRagPause = true
    wasEnabledBeforeRag = autoEnabled
    if autoEnabled then
        setAuto(false)
    end

    task.spawn(function()
        local t = 3.0
        while t >= 0 and inRagPause and cfg.ragdollSteal do
            task.wait(0.1)
            t = math.round((t - 0.1) * 10) / 10
            if t <= 0.5 and wasEnabledBeforeRag and not autoEnabled and cfg.ragdollSteal then
                setAuto(true)
                wasEnabledBeforeRag = false
            end
        end

        local function stillRag()
            local hum = localPlayer.Character
                and localPlayer.Character:FindFirstChildOfClass("Humanoid")
            if not hum then return false end
            local st = hum:GetState()
            return st == Enum.HumanoidStateType.Physics
                or st == Enum.HumanoidStateType.Ragdoll
                or st == Enum.HumanoidStateType.FallingDown
        end

        while cfg.ragdollSteal and stillRag() and inRagPause do
            task.wait(0.1)
        end

        if wasEnabledBeforeRag and not autoEnabled and cfg.ragdollSteal then
            setAuto(true)
        end
        inRagPause = false
        wasEnabledBeforeRag = false
    end)
end

local function watchRagForSteal(char)
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not cfg.ragdollSteal or inRagPause then return end
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.Physics
        or st == Enum.HumanoidStateType.Ragdoll
        or st == Enum.HumanoidStateType.FallingDown then
            enterRagPause()
        end
    end)
end

localPlayer.CharacterAdded:Connect(function(char)
    watchRagForSteal(char)
end)
if localPlayer.Character then
    task.spawn(watchRagForSteal, localPlayer.Character)
end

