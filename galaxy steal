-- Timing tables (exact values from original)
-- ──────────────────────────────────────────────────────────────
local TIMINGS = {
    V1 = { Average = 6.8,  Tryhard = 7.1 },
    V2 = { Average = 8.1,  Tryhard = 9.1 },
    V3 = { Average = 11.1, Tryhard = 12  },
    V4 = { Average = 9,    Tryhard = 9.7 },
}

local holdTime, triggerDist, postHold, extraDelay

local function applyMode(mode)
    local t = TIMINGS[mode]
    if t then
        triggerDist = t[cfg.delayPreference] or t.Average
    end

    if mode == "V1" then
        holdTime, postHold, extraDelay = 1.33, 1.15, 0
    elseif mode == "V2" then
        holdTime, postHold, extraDelay = 1.33, 1.00, 0.24
    elseif mode == "V3" then
        holdTime, postHold, extraDelay = 1.33, 1.15, 0.24
    elseif mode == "V4" then
        holdTime, postHold, extraDelay = 1.33, 1.33, 0.24
    end
end

applyMode(cfg.mode)

