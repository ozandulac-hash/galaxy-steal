    if not (isKey or isPad) then return end

    local name = tostring(input.KeyCode):gsub("Enum.KeyCode.", "")
    local expected = (isKey and "Keyboard" or "Gamepad") .. ":" .. name
    if expected == cfg.tpKeybind then
        if tick() - lastTP < 1 or tpInProgress then return end
        lastTP = tick()
        if doRagdollTP() then
            notify("Ragdoll TP: " .. (oppositeSide() or "?"), false)
        end
    end
end)

-- ──────────────────────────────────────────────────────────────
-- Proximity-prompt auto-steal
-- ──────────────────────────────────────────────────────────────
local stealState = {}   -- [prompt] = { hold={}, trigger={}, ready=true }
local currentlyStealing = false
local autoEnabled = false
local autoStealConn = nil
local wasEnabledBeforeRag = false
local inRagPause = false

local function findNearestStealPrompt()
    local char = localPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end

    local best, bestDist = nil, math.huge
    for _, plot in ipairs(plots:GetChildren()) do
        -- skip owned plots
        local sign = plot:FindFirstChild("PlotSign")
        if sign then
            local gui = sign:FindFirstChildWhichIsA("BillboardGui")
                      or sign:FindFirstChildWhichIsA("SurfaceGui")
            if gui and gui.Enabled then
                -- owned by someone, skip if it's us? original skips any enabled sign
                -- keep original behaviour: skip plots with enabled sign
            end
        end

        local podiums = plot:FindFirstChild("AnimalPodiums")
        if podiums then
            for _, podium in ipairs(podiums:GetChildren()) do
                pcall(function()
                    local base = podium:FindFirstChild("Base")
                    base = base and base:FindFirstChild("Spawn")
                    if base then
                        local dist = (base.Position - hrp.Position).Magnitude
                        if dist < bestDist and dist <= cfg.radius then
                            local att = base:FindFirstChild("PromptAttachment")
                            if att then
                                for _, child in ipairs(att:GetChildren()) do
                                    if child:IsA("ProximityPrompt")
                                    and child.ActionText
                                    and child.ActionText:find("Steal") then
                                        best = child
                                        bestDist = dist
                                        break
                                    end
                                end
                            end
                        end
                    end
                end)
            end
        end
    end
    return best, bestDist
end

local function firePrompt(prompt)
    if currentlyStealing then return end

    if not stealState[prompt] then
        stealState[prompt] = { hold = {}, trigger = {}, ready = true }
        pcall(function()
            if getconnections then
                for _, c in ipairs(getconnections(prompt.PromptButtonHoldBegan)) do
                    if c.Function then
                        table.insert(stealState[prompt].hold, c.Function)
                    end
                end
                for _, c in ipairs(getconnections(prompt.Triggered)) do
                    if c.Function then
                        table.insert(stealState[prompt].trigger, c.Function)
                    end
                end
            end
        end)
    end

    local entry = stealState[prompt]
    if not entry.ready then return end
    entry.ready = false
    currentlyStealing = true

    task.spawn(function()
        -- fire hold callbacks
        for _, fn in ipairs(entry.hold) do
            task.spawn(fn)
        end

        local start = tick()
        while currentlyStealing and autoEnabled do
            local elapsed = tick() - start
            if elapsed >= postHold then break end
            if not prompt.Parent or not prompt.Parent.Parent then break end
            local hrp = localPlayer.Character
                and localPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp and (hrp.Position - prompt.Parent.Parent.Position).Magnitude > cfg.radius then
                break
            end
            -- progress UI
            local pct = math.clamp(elapsed / holdTime, 0, 1)
            progressBar.Size = UDim2.new(pct, 0, 1, 0)
            progressText.Text = math.floor(pct * 100) .. "%"
            task.wait()
        end

        local maxWait = math.max(2.99 - postHold - math.max(holdTime - postHold, 0), 0.05)
        local waitStart = tick()
        while currentlyStealing and autoEnabled do
            if tick() - waitStart >= maxWait then break end
            if not prompt.Parent or not prompt.Parent.Parent then break end
            local hrp = localPlayer.Character
                and localPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (hrp.Position - prompt.Parent.Parent.Position).Magnitude
                if d <= triggerDist then break end
                if d > cfg.radius then break end
            end
            task.wait()
        end

        if extraDelay > 0 then task.wait(extraDelay) end

        if currentlyStealing and autoEnabled then
            -- finish progress
            local finishStart = tick()
            local remain = math.max(holdTime - postHold, 0.05)
            while true do
                local p = math.clamp((tick() - finishStart) / remain, 0, 1)
                local total = math.clamp(postHold / holdTime, 0, 1)
                progressBar.Size = UDim2.new(total + p * (1 - total), 0, 1, 0)
                progressText.Text = math.floor((total + p * (1 - total)) * 100) .. "%"
                if p >= 1 then break end
                task.wait()
            end
            for _, fn in ipairs(entry.trigger) do
                task.spawn(fn)
            end
        end

        progressBar.Size = UDim2.new(0, 0, 1, 0)
        progressText.Text = "0%"
        entry.ready = true
        currentlyStealing = false
    end)
end

local function startAutoSteal()
    if autoStealConn then return end
    autoStealConn = RunService.Heartbeat:Connect(function()
        if not autoEnabled or currentlyStealing then return end
        local prompt = findNearestStealPrompt()
        if prompt then firePrompt(prompt) end
    end)
end

local function stopAutoSteal()
    if autoStealConn then
        autoStealConn:Disconnect()
        autoStealConn = nil
    end
    currentlyStealing = false
    progressBar.Size = UDim2.new(0, 0, 1, 0)
    progressText.Text = "0%"
end

local function setAuto(on)
    autoEnabled = on
    cfg.autoEnabled = on
    saveConfig()

    if on then
        actGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, COL.purple2),
            ColorSequenceKeypoint.new(1, COL.purple3),
        })
        actLabel.Text = "ACTIVATED"
        actStroke.Color = COL.white
        actStroke.Transparency = 0
        statusText.Text = "ON"
        statusText.TextColor3 = COL.green
        tween(statusPill, { BackgroundColor3 = Color3.fromRGB(10, 40, 20) }, 0.2)
        mainStroke.Color = COL.green
        mainStroke.Transparency = 0.1
        startAutoSteal()
    else
        actGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, COL.purple1),
            ColorSequenceKeypoint.new(1, COL.purple2),
        })
        actLabel.Text = "ACTIVATE"
        actStroke.Color = COL.purple3
        actStroke.Transparency = 0.4
        statusText.Text = "OFF"
        statusText.TextColor3 = COL.red
        tween(statusPill, { BackgroundColor3 = Color3.fromRGB(40, 10, 60) }, 0.2)
        mainStroke.Color = COL.purple1
        mainStroke.Transparency = 0.35
        stopAutoSteal()
    end
end

