-- ──────────────────────────────────────────────────────────────
-- Config (persistent)
-- ──────────────────────────────────────────────────────────────
local CONFIG_FILE = "GalaxyAutoSteal_Config.json"

local DEFAULTS = {
    mode            = "V1",
    radius          = 60,
    autoEnabled     = false,
    scale           = 1,
    delayPreference = "Average",
    ragdollSteal    = false,
    autoRagdollTP   = false,
    tpKeybind       = nil,
}

local cfg = table.clone(DEFAULTS)

local function saveConfig()
    if writefile then
        pcall(writefile, CONFIG_FILE, HttpService:JSONEncode(cfg))
    end
end

local function loadConfig()
    if not (isfile and readfile and isfile(CONFIG_FILE)) then return end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)
    if not ok or type(data) ~= "table" then return end

    cfg.mode            = data.mode or DEFAULTS.mode
    cfg.radius          = tonumber(data.radius) or DEFAULTS.radius
    cfg.autoEnabled     = data.autoEnabled == true
    cfg.scale           = tonumber(data.scale) or DEFAULTS.scale
    cfg.delayPreference = (data.delayPreference == "Tryhard") and "Tryhard" or "Average"
    cfg.ragdollSteal    = data.ragdollSteal == true
    cfg.autoRagdollTP   = data.autoRagdollTP == true
    cfg.tpKeybind       = data.tpKeybind

    if cfg.tpKeybind and not cfg.tpKeybind:find(":") then
        cfg.tpKeybind = "Keyboard:" .. cfg.tpKeybind
    end
end

loadConfig()

